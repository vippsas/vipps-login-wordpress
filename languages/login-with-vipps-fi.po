msgstr "%1$s integraatioasetukset"

#: ContinueWithVipps.class.php:524
msgid "Choose which login method you'd like to enable for your users."
msgstr "Valitse minkä kirjautumistavan haluat ottaa käyttäjillesi käyttöön."

#: ContinueWithVipps.class.php:521
msgid "MobilePay"
msgstr "MobilePay"

#: ContinueWithVipps.class.php:518
msgid "Login method"
msgstr "Kirjautumistapa"

#: ContinueWithVipps.class.php:252
