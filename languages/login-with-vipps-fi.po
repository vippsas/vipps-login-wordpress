msgstr "Kirjaudu käyttämällä %1$s"

#: blocks/login-with-vipps.php:73
msgid "Log in with %1$s!"
msgstr "Kirjaudu käyttäen %1$s!"

#: VippsLogin.class.php:1545
msgid "Login not confirmed: This user is not the user mapped to the %1$s account, and does not have the same email account"
msgstr "Kirjautumista ei ole vahvistettu: Tämä käyttäjä ei ole se käyttäjä, joka on yhdistetty tiliin %1$s, eikä hänellä ole samaa sähköpostitiliä."

#: VippsLogin.class.php:1470
msgid "%1$s user with phone %2$s just connected to account %1$d"
msgstr "%1$s käyttäjä, jolla on puhelin %2$s on juuri yhdistetty tiliin %1$d"

#: VippsLogin.class.php:1394
msgid "You need to confirm your email account before Login with %1$s can be used. Login to your account normally and connect with %1$s on your user page, or contact the site admin"
msgstr "Sinun on vahvistettava sähköpostitilisi ennen kuin kirjautumista %1$s:llä voidaan käyttää. Kirjaudu tilillesi normaalisti ja muodosta yhteys käyttäjäsivullasi käyttäen %1$s tai ota yhteys sivuston ylläpitäjään"

#: VippsLogin.class.php:1382
msgid "%1$s user with phone %2$s just connected to account %3$d during login"
msgstr "%1$s käyttäjä, jolla on puhelin %2$s on juuri muodostanut yhteyden tiliin %3$d kirjautumisen yhteydessä"

#: VippsLogin.class.php:1340
msgid "%1$s user with phone %2$s just connected to account %3$d during account creation"
msgstr "%1$s käyttäjä, jolla on puhelin %2$s on juuri yhdistetty tiliin %3$d tilin luomisen yhteydessä"

#: VippsLogin.class.php:725 VippsWooLogin.class.php:542
msgid "Unmapping user %2$d from %1$s"
msgstr "Käyttäjän %2$d kartoituksen poistaminen %1$s:stä"

#: ContinueWithVipps.class.php:635
msgid "Could not create user identity table. The Login with %1$s plugin is not correctly installed."
msgstr "Käyttäjätunnusten taulukkoa ei voitu luoda. %1$s-lisäosan kirjautuminen ei ole asetettu oikein."

#: VippsWooLogin.class.php:629
msgid "Your addresses are now synchronized with the %1$s-account %2$s."
msgstr "Osoitteesi on nyt synkronoitu %1$s-tilin %2$s kanssa."

#: VippsWooLogin.class.php:539
msgid "You must be logged in to disconnect"
msgstr "Sinun täytyy olla kirjautunut katkaistaksesi yhteyden"

#: VippsWooLogin.class.php:530
msgid "Get addresses"
msgstr "Hanki osoitteet"

#: ContinueWithVipps.class.php:520
msgid "Vipps"
msgstr "Vipps"

#: VippsWooLogin.class.php:484
msgid "You are now connected to the %1$s profile <b>%2$s</b>!"
msgstr "Sinut on nyt yhdistetty %1$s-profiiliin <b>%2$s</b>!"

#: VippsWooLogin.class.php:415
msgid "Create an account using %s"
msgstr "Luo tili käyttäen %s"

#: VippsWooLogin.class.php:385
msgid "Are you registered as a customer? Log in with %s."
msgstr "Oletko rekisteröitynyt asiakkaaksi? Kirjaudu sisään %s avulla."

#: VippsWooLogin.class.php:353
msgid "Click to continue"
msgstr "Klikkaa jatkaaksesi"

#: VippsWooLogin.class.php:350
msgid "Are you registered as a customer? Log in with %s to continue your checkout."
msgstr "Oletko reskiteröitynyt asiakkaaksi? Kirjaudu sisään %s avulla jatkaaksesi maksamista."

#: VippsWooLogin.class.php:348
msgid "Log in or register an account with %s to continue your checkout."
msgstr "Kirjaudu sisään tai rekisteröi tili käyttämällä %s jatkaaksesi kassalla."

#: VippsWooLogin.class.php:196
msgid "Normally, WooCommerce-banners like this will use a \"click here\"-text. If you don't, check here to make the entire banner clickable like a button"
msgstr "Normaalisti, WooCommerce-bannerit, kuten tämä, käyttää \"klikkaa tästä\"-tekstiä. Jos sinä et käytä, tarkista täältä, että koko banneri on napsautettavissa kuin painike."

#: VippsWooLogin.class.php:194
msgid "Make the entire banner clickable"
msgstr "Tee koko bannerista klikattava"

#: VippsWooLogin.class.php:189 VippsWooLogin.class.php:388
#: VippsWooLogin.class.php:414
msgid "Click here to continue"
msgstr "Klikkaa tästä jatkaaksesi"

#: VippsWooLogin.class.php:383
msgid "Log in or register an account using %s."
msgstr "Kirjaudu sisään tai rekisteröi tili käyttämällä %s."

#: VippsWooLogin.class.php:180
msgid "Change \"Continue with %1$s\" banner text"
msgstr "Muuta \"Jatka käyttäen %1$s\" bannerin tekstiä"

#: VippsWooLogin.class.php:176
msgid "This will replace Express Checkout on the checkout page."
msgstr "Tämä korvaa pikakassan kassasivulla."

#: VippsWooLogin.class.php:174
msgid "Show \"Continue with %1$s\" on the Checkout page"
msgstr "Näytä \"Jatka käyttäen %1$s\" kassasivulla"

#: VippsWooLogin.class.php:170
msgid "If you are using Express Checkout, that will be shown instead."
msgstr "Mikäli käytät pikakassaa, se näytetään sen sijaan."

#: VippsWooLogin.class.php:168
msgid "Show \"Continue with %1$s\" in Cart page and widgets"
msgstr "Näytä \"Jatka käyttäen %1$s\" ostoskorisivulla ja widgeteissä"

#: VippsWooLogin.class.php:164
msgid "Enable new users to be created as customers if using Login with %1$s with WooCommerce. If you are using the payment gateway, this will have been configured to create new users when using Express Checkout - checkout the payment gateway settings to modify this."
msgstr "Salli uusien käyttäjien luominen asiakkaiksi, jos käytät WooCommercen kanssa apuna kirjautumista käyttäen %1$s. Jos käytät maksuporttia, tämä on määritetty luomaan uusia käyttäjiä, kun käytössäsi on pikakassa - tarkista maksuportin asetukset muuttaaksesi tätä ominaisuutta."

#: VippsWooLogin.class.php:162
msgid "Allow users to register as customers in WooCommerce using Login with %1$s"
msgstr "Salli käyttäjien rekisteröityä asiakkaiksi WooCommerceen käyttäen kohteen %1$s sisäänkirjautumista"

#: VippsWooLogin.class.php:158
msgid "Enable Login with %1$s on your customer's pages in WooCommerce"
msgstr "Salli kirjautuminen käyttäen %1$s asiakkaan sivuilla WooCommercessa"

#: VippsWooLogin.class.php:156
msgid "Enable Login with %1$s for WooCommerce"
msgstr "Salli WooCommerceen kirjautuminen käyttäen %1$s"

#: VippsLogin.class.php:1590
msgid "Could not synchronize your %1$s profile: "
msgstr "%1$s-profiiliasi: ei voitu synkronoida "

#: VippsLogin.class.php:1572
msgid "You must be logged in to synchronise your account"
msgstr "Sinun tulee olla kirjautunut synkronoidaksesi tilisi"

#: VippsLogin.class.php:1565
msgid "<a href='%s'>Return to your previous page</a> to try again</a>"
msgstr "<a href='%s'>Palaa edelliselle sivulle</a> ja yritä uudelleen</a>"

#: VippsLogin.class.php:1563
msgid "Cannot log in: It is required for this account to verify login with the %1$s app"
msgstr "Sisäänkirjautuminen ei onnistu: Tämän tilin on vahvistettava kirjautuminen %1$s avulla."

#: VippsLogin.class.php:1492 VippsLogin.class.php:1499
msgid "Not a valid user"
msgstr "Ei voimassaoleva käyttäjä"

#: VippsLogin.class.php:1463
msgid "Unfortunately, you cannot connect to this %1$s-profile: The email addresses are not the same."
msgstr "Valitettavasti et voi muodostaa yhteyttä tähän %1$s-profiiliin: Sähköpostiosoitteet eivät ole samat."

#: VippsLogin.class.php:1432 VippsLogin.class.php:1599
msgid "This can only be called when logged in"
msgstr "Tätä voidaan kutsua vain kirjautuneena sisään"

#: VippsLogin.class.php:1423
msgid "Could not connect to your %1$s profile: "
msgstr "Yhteyttä %1$s-profiilisi ei voitu muodostaa "

#: VippsLogin.class.php:1402
msgid "You must be logged in to confirm your account"
msgstr "Sinun tulee olla kirjautunut vahvistaaksesi tilisi"

#: VippsLogin.class.php:1362
msgid "It is unfortunately not allowed for your account to log-in using %1$s"
msgstr "Tilillesi ei valitettavasti ole sallittua kirjautua käyttämällä %1$s"

#: VippsLogin.class.php:1322
msgid "Could not create a new user - an error occured: %s"
msgstr "Uutta käyttäjää ei voitu luoda - ilmeni ongelma: %s"

#: VippsLogin.class.php:1304
msgid "Could not find any user with your registered email. Cannot log in."
msgstr "Käyttäjää ei löytynyt rekisteröidyllä sähköpostiosoitteellasi. Kirjautuminen ei onnistu."

#: VippsLogin.class.php:1291
msgid "Your login session is missing. Ensure that you are accessing this site on a secure link (using HTTPS). Also, ensure that you are not blocking cookies – you will need those to log in."
msgstr "Kirjautumisistunto puuttuu. Varmista, että käytät tätä sivustoa suojatun linkin kautta (https). Varmista myös, että et ole estänyt evästeitä - tarvitset niitä kirjautuaksesi sisään."

#: VippsLogin.class.php:1037
msgid "Welcome! If you see this page, an really unexpected error has occur. Unfortunately, we can't do better than to send you to the <a href='%s'>login page</a>"
msgstr "Tervetuloa! Jos näet tämän sivun, on tapahtunut odottamaton virhe. Valitettavasti emme voi tehdä muuta kuin lähettää sinut <a href='%s'>sisäänkirjautumissivulle</a>"

#: VippsLogin.class.php:1001
msgid "This page is used to handle your requests when continuing from %1$s and further action is required to complete your task. But in this case, it doesn't seem to be an open session"
msgstr "Tätä sivua käytetään pyyntöjesi käsittelyyn, kun jatkat %1$s:stä ja tehtäväsi loppuunsaattaminen edellyttää lisätoimia. Kuitenkaan tässä tapauksessa kyseessä ei näytä olevan avoin istunto"

#: VippsLogin.class.php:984
msgid "Cannot redirect to %1$s waiting page as it doesn't exist. If you just tried to log in, check your email."
msgstr "Ohjaaminen kohteen %1$s odotussivulle ei onnistu, sillä sitä ei ole olemassa. Mikäli yritit juuri kirjautua sisään, tarkista sähköpostisi."

#: VippsLogin.class.php:727 VippsWooLogin.class.php:551
msgid "Connection to %1$s profile %2$s <b>removed</b>."
msgstr "Yhteys %1$s profiiliin %2$s <b>poistettu</b>."

#: VippsLogin.class.php:684
msgid "It is unfortunately not possible for your account to use %1$s to log in to this system due to the site administrators policy."
msgstr "Valitettavasti tilisi ei ole mahdollista käyttää %1$s:ä tähän järjestelmään kirjautumiseen sivuston ylläpitäjien asettamien käytäntöjen vuoksi."

#: VippsLogin.class.php:682
msgid "Login with %1$s is disabled"
msgstr "Kirjautuminen käyttäen %1$s on poistettu käytöstä"

#: VippsLogin.class.php:670
msgid "If you check this, this user will not be allowed to log in without confirming this operation with their %1$s app - email addresses must match."
msgstr "Jos valitset tämän, käyttäjä ei saa kirjautua sisään ilman tämän toiminnon vahvistamista %1$s-sovelluksellaan - sähköpostiosoitteiden on täsmättävä."

#: VippsLogin.class.php:669
msgid "Only if member of restricted groups"
msgstr "Vain, jos kuuluu rajoitettuihin ryhmiin"

#: VippsLogin.class.php:666
msgid "No, allow login without the app"
msgstr "Ei, salli kirjautuminen ilman sovellusta"

#: VippsLogin.class.php:663
msgid "Yes, require confirmation"
msgstr "Kyllä, vaadi vahvistus"

#: VippsLogin.class.php:657
msgid "Require this user to confirm their login with %1$s if logging in normally"
msgstr "Vaadi tätä käyttäjää vahvistamaan kirjautumisensa käyttäen %1$s, jos kyseessä on normaali kirjautuminen"

#: VippsLogin.class.php:651
msgid "You can connect to your %1$s profile if you use the same email address in the %1$s app and on this site."
msgstr "Voit muodostaa yhteyden %1$s-profiiliisi, jos käytät samaa sähköpostiosoitetta %1$s-sovelluksessa sekä tällä sivustolla."

#: VippsLogin.class.php:649
msgid "The user is not connected to a %1$s profile."
msgstr "Käyttäjää ei ole yhdistetty %1$s-profiiliin."

#: VippsLogin.class.php:647 VippsWooLogin.class.php:519
msgid "Press here to connect with your app"
msgstr "Paina tästä muodostaaksesi yhteyden sovellukseesi"

#: VippsLogin.class.php:646
msgid "You are not connected to any %1$s profile"
msgstr "Sinua ei ole yhdistetty mihinkään %1$s-profiiliin"

#: VippsLogin.class.php:643
msgid "As long as your profile is connected to %1$s, you can log in with %1$s."
msgstr "Kunhan profiilisi on yhdistetty kohteeseen %1$s, voit kirjautua sisään %1$s avulla."

#: VippsLogin.class.php:642 VippsWooLogin.class.php:514
msgid "Unlink account"
msgstr "Poista tilin linkitys"

#: VippsLogin.class.php:640
msgid "The user is connected to the %1$s profile with the phone number <b>%2$s</b>"
