#: VippsWooLogin.class.php:521
msgid "The easiest way to log in. Anyone with %1$s can use %1$s to log in. No need to remember passwords ever again."
msgstr "Helpoin tapa kirjautua sisään. Kuka tahansa, jolla on %1$s, voi käyttää %1$s kirjautumiseen. Ei tarvetta muistaa salasanoja enää koskaan."

#: VippsWooLogin.class.php:201
msgid "Login with %1$s for WooCommerce"
msgstr "Kirjaudu WooCommerceen käyttäen %1$s"

#: VippsWooLogin.class.php:187
msgid "Change \"Continue with %1$s\" banner link text"
msgstr "Muuta \"Jatka käyttäen %1$s\" bannerin linkin tekstiä"

#: VippsWooLogin.class.php:183 VippsWooLogin.class.php:190
msgid "The \"Continue with %1$s\" banner will have slightly different text depending on context, and some of these are rather long. You can change these dynamically if using hooks and filters, or you can use this override to change the standard text."
msgstr "\"Jatka käyttäen %1$s\" bannerin teksti on hieman erilainen riippuen asiayhteydestä ja osa niistä on melko pitkiä. Voit muuttaa näitä dynaamisesti, jos käytät alkukoukkuja ja suodattimia tai voit käyttää tätä ohitusta muuttaaksesi vakiotekstiä."

#: VippsWooLogin.class.php:182
msgid "Log in or register an account using %1$s."
msgstr "Kirjaudu sisään tai rekisteröi tili käyttämällä %1$s."

#: VippsLogin.class.php:630
msgid "Log in with %1$s"
msgstr "Kirjaudu käyttäen %1$s"

#: VippsLogin.class.php:474
msgid "Require users in these roles to log in with %1$s"
msgstr "Vaadi tämän roolin käyttäjiltä kirjautumista käyttäen %1$s"

#: VippsLogin.class.php:47
