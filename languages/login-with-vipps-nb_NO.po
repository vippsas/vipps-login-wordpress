#: VippsLogin.class.php:1470
msgid "%1$s user with phone %2$s just connected to account %1$d"
msgstr "%1$s-bruker med telefon %2$s koblet akkurat til konto %1$d"

#: VippsLogin.class.php:1394
msgid "You need to confirm your email account before Login with %1$s can be used. Login to your account normally and connect with %1$s on your user page, or contact the site admin"
msgstr "Du må bekrefte e-postkontoen din før innlogging med %1$s kan brukes. Logg inn på kontoen din på vanlig måte og koble til %1$s på din brukerside, eller kontakt nettstedsadministratoren."

#: VippsLogin.class.php:1382
msgid "%1$s user with phone %2$s just connected to account %3$d during login"
msgstr "%1$s-bruker med telefon %2$s koblet akkurat til konto %3$d under innlogging"

#: VippsLogin.class.php:1340
msgid "%1$s user with phone %2$s just connected to account %3$d during account creation"
msgstr "%1$s-bruker med telefon %2$s koblet akkurat til konto %3$d under oppretting av konto"

